class Solution {
    public int aggressiveCows(int[] arr, int k) {
        int n=arr.length;
        Arrays.sort(arr);
        int low=1;
        int high=arr[n-1]-arr[0];
        int ans=0;
        while(low<=high){
            int mid=low+(high-low)/2;
            int cows=1;
            int position=arr[0];
            for(int i=1;i<n;i++){
                if(arr[i]-position>=mid){
                    cows++;
                    position=arr[i];
                }
            }
            if(cows>=k){
                ans=mid;
                low=mid+1;
            }
            else high=mid-1;
        }
        return ans;
    }
}
